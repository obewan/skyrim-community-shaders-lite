#pragma once

#include <string_view>

namespace Plugin
{
	using namespace std::literals;

	inline constexpr REL::Version VERSION
	{
		// clang-format off
		@PROJECT_VERSION_MAJOR@u,
		@PROJECT_VERSION_MINOR@u,
		@PROJECT_VERSION_PATCH@u,
		// clang-format on
	};

	/// Runtime identity: DLL, log and data-path name. Not the product name users see.
	inline constexpr auto NAME = "@PROJECT_NAME@"sv;

	/// Product name shown to users, e.g. in the menu title and startup log line.
	inline constexpr auto PRODUCT_NAME = "@PRODUCT_NAME@"sv;

	/// Product version shown to users, e.g. "1.0.0". VERSION stays on the Community Shaders
	/// release this build is based on, for SKSE, presets and other compatibility checks.
	inline constexpr auto PRODUCT_VERSION = "@PRODUCT_VERSION@"sv;

	/// Full git describe string, e.g. "v1.0.0", "v1.0.0-3-gabcdef1", "v1.0.0-3-gabcdef1-dirty".
	/// Matches "v{PRODUCT_VERSION}" exactly on a clean tagged release build.
	inline constexpr auto BUILD_DESCRIBE = "@GIT_DESCRIBE@"sv;

	/// Build branch, "*" for local (non-CI) builds; empty when detached.
	inline constexpr auto BUILD_BRANCH = "@GIT_BRANCH@"sv;
}
